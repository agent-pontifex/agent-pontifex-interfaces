{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-pontifex.github.io/schemas/common.schema.json",
  "title": "Agent Pontifex common contract primitives",
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9._-]+$",
      "description": "Lowercase ASCII identifier. Mirrors validate_identifier in agent-pontifex-protocol."
    },
    "namespacedIdentifier": {
      "allOf": [
        { "$ref": "#/$defs/identifier" },
        { "type": "string", "pattern": "\\." }
      ],
      "description": "An identifier that must carry a namespace segment."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 timestamp. Wire type is string, never a number."
    },
    "protocolVersionRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_major", "max_major"],
      "properties": {
        "min_major": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "max_major": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "errorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error"],
      "properties": {
        "ok": { "type": "boolean" },
        "error": { "type": "string" },
        "message": { "type": "string" },
        "details": {}
      }
    }
  }
}
